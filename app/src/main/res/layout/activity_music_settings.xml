<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐配置页：音乐开关 / 目录选择 / 扫描 / 歌手词典管理 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bar_top_divider"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/btn_music_settings_back"
            style="@style/Xz.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_settings_back" />

        <TextView
            style="@style/Xz.Text.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/music_settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 音乐播放 -->
            <LinearLayout
                style="@style/Xz.Card"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Xz.Text.GroupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/settings_group_music" />

                <!-- 音乐功能开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Xz.Text.LabelStrong"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_music_enable" />

                        <TextView
                            style="@style/Xz.Text.Hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_music_enable_hint" />
                    </LinearLayout>

                    <org.oxff.helloxiaozhi.ui.view.XzSwitch
                        android:id="@+id/music_switch"
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- 本地音乐目录 -->
                <TextView
                    style="@style/Xz.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_music_local_path" />

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_music_local_path_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/music_local_path_text"
                        style="@style/Xz.Text.Hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_music_not_configured" />

                    <TextView
                        android:id="@+id/btn_music_local_select"
                        style="@style/Xz.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_music_select" />
                </LinearLayout>

                <!-- 网络共享目录 -->
                <TextView
                    style="@style/Xz.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_music_saf_uri" />

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/settings_music_saf_uri_hint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/music_saf_uri_text"
                        style="@style/Xz.Text.Hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_music_not_configured" />

                    <TextView
                        android:id="@+id/btn_music_saf_select"
                        style="@style/Xz.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/settings_music_select" />
                </LinearLayout>

                <!-- 扫描音乐库 -->
                <TextView
                    android:id="@+id/btn_music_scan"
                    style="@style/Xz.Button.Primary"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_music_scan" />

                <TextView
                    android:id="@+id/music_scan_status"
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_music_not_configured" />

                <TextView
                    android:id="@+id/music_tracks_count"
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 歌手词典管理 -->
            <LinearLayout
                style="@style/Xz.Card"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Xz.Text.GroupTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/music_dict_title" />

                <TextView
                    android:id="@+id/music_dict_builtin_count"
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/music_dict_builtin_count" />

                <TextView
                    style="@style/Xz.Text.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/music_dict_user_section" />

                <TextView
                    android:id="@+id/music_dict_user_empty"
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/music_dict_user_empty"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/music_dict_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_dict_import_artist"
                        style="@style/Xz.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/music_dict_import_artist" />

                    <TextView
                        android:id="@+id/btn_dict_import_band"
                        style="@style/Xz.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="@string/music_dict_import_band" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_dict_export"
                    style="@style/Xz.Button.Ghost"
                    android:layout_marginTop="8dp"
                    android:text="@string/music_dict_export" />

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/music_dict_import_hint" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </LinearLayout>

    <!-- Toast 宿主 -->
    <org.oxff.helloxiaozhi.ui.view.ToastHost
        android:id="@+id/toast_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
