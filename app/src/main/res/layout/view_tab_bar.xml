<?xml version="1.0" encoding="utf-8"?>
<!-- 底部 Tab 栏：聊天 / 通讯录 / 设置（对应设计稿 .tab-bar） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bar_top_divider"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/xz_safe_bottom">

    <LinearLayout
        android:id="@+id/tab_chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground">

        <!-- 容器随角标自适应生长（无角标时仍为 24dp），避免角标多位数字被测量钳制/裁剪 -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="24dp"
            android:minHeight="24dp">

            <ImageView
                android:id="@+id/tab_chat_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tab_chat"
                android:tint="@color/xz_text_hint" />

            <TextView
                android:id="@+id/tab_chat_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginStart="14dp"
                android:minWidth="16dp"
                android:background="@drawable/bg_pill_error"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@color/xz_text_on_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tab_chat_label"
            style="@style/Xz.Text.TabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/tab_chat" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_contacts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/tab_contacts_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tab_contacts"
            android:tint="@color/xz_text_hint" />

        <TextView
            android:id="@+id/tab_contacts_label"
            style="@style/Xz.Text.TabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/tab_contacts" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_settings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/tab_settings_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_tab_settings"
            android:tint="@color/xz_text_hint" />

        <TextView
            android:id="@+id/tab_settings_label"
            style="@style/Xz.Text.TabLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/tab_settings" />
    </LinearLayout>
</LinearLayout>
