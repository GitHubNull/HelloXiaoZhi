<?xml version="1.0" encoding="utf-8"?>
<!-- 激活对话框内容：验证码大字 + 提示 + 轮询状态（按钮由 AlertDialog 提供） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/activation_hint"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/activation_code_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:textColor="@color/bubble_user"
        android:textSize="46sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/activation_status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/activation_waiting"
        android:textColor="@color/time_text"
        android:textSize="13sp" />
</LinearLayout>
