<?xml version="1.0" encoding="utf-8"?>
<!-- 设备激活模态框（对应设计稿 #activation-modal） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_modal_icon">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_device"
            android:tint="@color/xz_primary" />
    </FrameLayout>

    <TextView
        style="@style/Xz.Text.ModalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/activation_title" />

    <TextView
        style="@style/Xz.Text.Hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/activation_desc" />

    <TextView
        android:id="@+id/active_code"
        style="@style/Xz.Text.ActivationCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_code_box"
        android:padding="14dp"
        android:text="@string/activation_code_placeholder" />

    <TextView
        android:id="@+id/btn_check_active"
        style="@style/Xz.Button.Primary"
        android:layout_marginTop="20dp"
        android:text="@string/activation_check_now" />

    <TextView
        android:id="@+id/btn_cancel_active"
        style="@style/Xz.Button.Ghost"
        android:layout_marginTop="10dp"
        android:text="@string/action_cancel" />
</LinearLayout>
