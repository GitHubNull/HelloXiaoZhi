<?xml version="1.0" encoding="utf-8"?>
<!-- 顶部导航栏：标题 + ws 地址副标题 + 连接状态灯（对应设计稿 .nav-bar） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bar_bottom_divider"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nav_title"
            style="@style/Xz.Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_title" />

        <TextView
            android:id="@+id/nav_subtitle"
            style="@style/Xz.Text.Mono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="190dp"
            tools:text="wss://api.tenclass.net/xiaozhi/v1/"
            xmlns:tools="http://schemas.android.com/tools" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/status_disconnected"
            android:textColor="@color/xz_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
