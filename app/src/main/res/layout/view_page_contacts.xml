<?xml version="1.0" encoding="utf-8"?>
<!-- 通讯录 Tab：机器人列表 + 添加按钮（对应设计稿 .contacts-view） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/Xz.Text.SectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/contacts_title" />

        <TextView
            android:id="@+id/contacts_count"
            style="@style/Xz.Text.Hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bot_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/btn_add_bot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_dashed_primary"
        android:gravity="center"
        android:padding="14dp"
        android:text="@string/contacts_add"
        android:textColor="@color/xz_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
