<?xml version="1.0" encoding="utf-8"?>
<!--
  三 Tab 外壳（对应设计稿 index.html 的 .phone-frame > .app-body）：
  导航栏 → Tab 内容区（三个页面 + 对话详情滑入层）→ Tab 栏 → 模态框宿主 → Toast 宿主。
  层叠顺序即子 View 顺序：Tab 内容 < Tab 栏 < 对话详情 < 模态框 < Toast。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xz_bg_deep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_nav_bar" />

        <FrameLayout
            android:id="@+id/tab_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                android:id="@+id/page_chat"
                layout="@layout/view_page_chat" />

            <include
                android:id="@+id/page_contacts"
                layout="@layout/view_page_contacts"
                android:visibility="gone" />

            <include
                android:id="@+id/page_settings"
                layout="@layout/view_page_settings"
                android:visibility="gone" />

            <org.oxff.helloxiaozhi.ui.view.SlideInContainer
                android:id="@+id/chat_detail_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include layout="@layout/view_chat_detail" />
            </org.oxff.helloxiaozhi.ui.view.SlideInContainer>
        </FrameLayout>

        <include layout="@layout/view_tab_bar" />
    </LinearLayout>

    <org.oxff.helloxiaozhi.ui.view.ModalHost
        android:id="@+id/modal_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.oxff.helloxiaozhi.ui.view.ToastHost
        android:id="@+id/toast_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
