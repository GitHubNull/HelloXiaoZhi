<?xml version="1.0" encoding="utf-8"?>
<!-- 语音通话页（对应设计稿 call.html）：状态 + 计时 → 星河动画 → 历史 → 三按钮控制栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xz_bg_deep"
    android:orientation="vertical">

    <!-- 顶部：通话状态 + 计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/call_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_connecting"
            android:textColor="@color/xz_text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_timer"
            style="@style/Xz.Text.MonoTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/call_timer_zero" />
    </LinearLayout>

    <!-- 中间：星河动画 + 历史记录 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- 二进制星河（对应设计稿 .pool-stage） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_translucent"
            android:orientation="vertical"
            android:padding="10dp">

            <org.oxff.helloxiaozhi.ui.view.StarfieldCallView
                android:id="@+id/starfield"
                android:layout_width="match_parent"
                android:layout_height="@dimen/xz_starfield_height" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/call_label_ai" />

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_label_internet"
                    android:textSize="10sp" />

                <TextView
                    style="@style/Xz.Text.Hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/call_label_user" />
            </LinearLayout>
        </LinearLayout>

        <!-- 通话历史（对应设计稿 .chat-history） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/call_history"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_translucent"
            android:clipToPadding="false"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 底部控制栏（对应设计稿 .call-controls） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bar_top_divider"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- 增益弹出层（默认隐藏，点击对应按钮弹出） -->
        <include
            android:id="@+id/ai_gain_pop"
            layout="@layout/view_gain_popover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="22dp"
            android:layout_marginBottom="78dp"
            android:visibility="gone" />

        <include
            android:id="@+id/user_gain_pop"
            layout="@layout/view_gain_popover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="78dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 机器人增益 -->
            <LinearLayout
                android:id="@+id/btn_ai_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ctrl_ai">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_speaker"
                        android:tint="@color/xz_accent_ai" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/call_gain_ai_label" />
            </LinearLayout>

            <!-- 挂断 -->
            <LinearLayout
                android:id="@+id/btn_hangup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_hangup">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hangup"
                        android:tint="@color/xz_text_on_primary" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/hang_up"
                    android:textColor="@color/xz_text_hint" />
            </LinearLayout>

            <!-- 你的增益 -->
            <LinearLayout
                android:id="@+id/btn_user_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ctrl_user">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/xz_primary" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/call_gain_user_label" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
