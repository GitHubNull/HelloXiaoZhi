<?xml version="1.0" encoding="utf-8"?>
<!-- 语音通话页（对应设计稿 call.html）：状态 + 计时 → 水波涟漪动画 → 历史 → 三按钮控制栏 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xz_bg_deep"
    android:orientation="vertical">

    <!-- 顶部：视图切换按钮（文字/动画） -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/call_top_pad_t"
        android:paddingBottom="@dimen/call_top_pad_b">

        <FrameLayout
            android:id="@+id/view_toggle"
            android:layout_width="@dimen/call_toggle_w"
            android:layout_height="@dimen/call_toggle_h"
            android:background="@drawable/bg_view_switch">

            <TextView
                android:id="@+id/vs_label_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/call_toggle_label_margin"
                android:text="@string/call_view_text"
                android:textColor="@color/xz_text_hint"
                android:textSize="@dimen/call_toggle_label_ts"
                android:letterSpacing="0.09" />

            <TextView
                android:id="@+id/vs_label_anim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="@dimen/call_toggle_label_margin"
                android:text="@string/call_view_anim"
                android:textColor="@color/xz_primary"
                android:textSize="@dimen/call_toggle_label_ts"
                android:letterSpacing="0.09" />

            <View
                android:id="@+id/vs_thumb"
                android:layout_width="@dimen/call_thumb_w"
                android:layout_height="@dimen/call_thumb_h"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="@dimen/call_thumb_margin"
                android:background="@drawable/bg_view_switch_thumb" />
        </FrameLayout>
    </LinearLayout>

    <!-- 中间：动画/文字互斥区域 -->
    <FrameLayout
        android:id="@+id/middle_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/call_side_pad"
        android:paddingEnd="@dimen/call_side_pad">

        <!-- 动画面板（默认显示） -->
        <LinearLayout
            android:id="@+id/anim_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- 状态与计时 -->
            <LinearLayout
                android:id="@+id/status_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/call_state_pad_t"
                android:paddingBottom="@dimen/call_state_pad_b">

                <TextView
                    android:id="@+id/call_timer"
                    style="@style/Xz.Text.MonoTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/call_timer_zero" />

                <TextView
                    android:id="@+id/call_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_state_margin_t"
                    android:text="@string/call_connecting"
                    android:textColor="@color/xz_text_secondary"
                    android:textSize="@dimen/call_state_ts"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 水波涟漪动画 -->
            <FrameLayout
                android:id="@+id/pool_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_translucent"
                android:padding="@dimen/call_pool_pad">

                <org.oxff.helloxiaozhi.ui.view.RippleCallView
                    android:id="@+id/ripple_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <!-- 文字历史面板（默认隐藏） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/call_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_panel_translucent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone" />

        <!-- 小屏进入倒计时弹窗：停留完整界面 8 秒后自动收起为纯动画界面 -->
        <LinearLayout
            android:id="@+id/countdown_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_countdown_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/xz_primary"
                android:textSize="@dimen/call_state_ts"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/call_countdown_hint"
                android:textColor="@color/xz_text_secondary"
                android:textSize="@dimen/call_toggle_label_ts" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部控制栏（对应设计稿 .call-controls） -->
    <FrameLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bar_top_divider"
        android:paddingTop="@dimen/call_bar_pad_v"
        android:paddingBottom="@dimen/call_bar_pad_v">

        <!-- 增益弹出层（默认隐藏，点击对应按钮弹出） -->
        <include
            android:id="@+id/ai_gain_pop"
            layout="@layout/view_gain_popover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="@dimen/call_gain_pop_margin_x"
            android:layout_marginBottom="@dimen/call_gain_pop_margin_b"
            android:visibility="gone" />

        <include
            android:id="@+id/user_gain_pop"
            layout="@layout/view_gain_popover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/call_gain_pop_margin_x"
            android:layout_marginBottom="@dimen/call_gain_pop_margin_b"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 机器人增益 -->
            <LinearLayout
                android:id="@+id/btn_ai_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="@dimen/call_ctrl_btn"
                    android:layout_height="@dimen/call_ctrl_btn"
                    android:background="@drawable/bg_ctrl_ai">

                    <ImageView
                        android:layout_width="@dimen/call_ctrl_icon"
                        android:layout_height="@dimen/call_ctrl_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_speaker"
                        android:tint="@color/xz_accent_ai" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_ctrl_label_margin_t"
                    android:text="@string/call_gain_ai_label" />
            </LinearLayout>

            <!-- 挂断 -->
            <LinearLayout
                android:id="@+id/btn_hangup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/call_ctrl_gap"
                android:layout_marginEnd="@dimen/call_ctrl_gap"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="@dimen/call_hangup_btn"
                    android:layout_height="@dimen/call_hangup_btn"
                    android:background="@drawable/bg_hangup">

                    <ImageView
                        android:layout_width="@dimen/call_hangup_icon"
                        android:layout_height="@dimen/call_hangup_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_hangup"
                        android:tint="@color/xz_text_on_primary" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_ctrl_label_margin_t"
                    android:text="@string/hang_up"
                    android:textColor="@color/xz_text_hint" />
            </LinearLayout>

            <!-- 你的增益 -->
            <LinearLayout
                android:id="@+id/btn_user_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?attr/selectableItemBackground">

                <FrameLayout
                    android:layout_width="@dimen/call_ctrl_btn"
                    android:layout_height="@dimen/call_ctrl_btn"
                    android:background="@drawable/bg_ctrl_user">

                    <ImageView
                        android:layout_width="@dimen/call_ctrl_icon"
                        android:layout_height="@dimen/call_ctrl_icon"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/xz_primary" />
                </FrameLayout>

                <TextView
                    style="@style/Xz.Text.CtrlLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/call_ctrl_label_margin_t"
                    android:text="@string/call_gain_user_label" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
