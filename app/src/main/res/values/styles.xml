<?xml version="1.0" encoding="utf-8"?>
<!--
  文本外观与控件样式：对应设计稿 common.css / index.css / call.css 的字号与控件规则。
  font-mono（JetBrains Mono/Cascadia）无系统等价字体，统一降级为 monospace。
-->
<resources>

    <!-- ============ 文本外观 ============ -->

    <!-- .nav-title { font-size: 17px; font-weight: 700 } -->
    <style name="Xz.Text.Title" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_text_primary</item>
    </style>

    <!-- .chat-list-title / .contacts-title / .settings-title { font-size: 20px; 700 } -->
    <style name="Xz.Text.SectionTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_text_primary</item>
    </style>

    <!-- .modal-title { font-size: 17px; 700 } -->
    <style name="Xz.Text.ModalTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_text_primary</item>
    </style>

    <!-- .group-title / .danger-title { font-size: 12px; 600; letter-spacing: 2px } -->
    <style name="Xz.Text.GroupTitle" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_primary</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <!-- .msg-bubble { font-size: 14.5px; line-height: 1.55 } -->
    <style name="Xz.Text.Body" parent="">
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/xz_text_primary</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- .chat-name / .bot-name { font-size: 15px; 600 } -->
    <style name="Xz.Text.ItemTitle" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_text_primary</item>
    </style>

    <!-- .chat-preview { font-size: 13px; text-secondary } -->
    <style name="Xz.Text.Preview" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/xz_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- .field-label { font-size: 12.5px; text-secondary } -->
    <style name="Xz.Text.Label" parent="">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/xz_text_secondary</item>
    </style>

    <!-- .switch-row .field-label { font-size: 14px; text-primary } -->
    <style name="Xz.Text.LabelStrong" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/xz_text_primary</item>
    </style>

    <!-- .field-hint / .bot-desc { font-size: 11px; text-hint } -->
    <style name="Xz.Text.Hint" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/xz_text_hint</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- .msg-time / .chat-time { font-size: 10~11px; text-hint } -->
    <style name="Xz.Text.Time" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/xz_text_hint</item>
    </style>

    <!-- .nav-subtitle { font-size: 10px; font-mono } -->
    <style name="Xz.Text.Mono" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/xz_text_hint</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- .call-timer { font-size: 13px; font-mono; letter-spacing: 2px } -->
    <style name="Xz.Text.MonoTimer" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/xz_text_hint</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.15</item>
    </style>

    <!-- .active-code { font-size: 34px; 700; letter-spacing: 10px; 带发光 } -->
    <style name="Xz.Text.ActivationCode" parent="">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- .mac-activate-code { font-size: 28px; letter-spacing: 8px } -->
    <style name="Xz.Text.MacCode" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/xz_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.26</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- .bot-tag / .bot-wake-badge / .mac-tag 胶囊文字 -->
    <style name="Xz.Text.Pill" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/xz_text_secondary</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:background">@drawable/bg_pill_neutral</item>
    </style>

    <!-- .tab-item .tab-label { font-size: 10px } -->
    <style name="Xz.Text.TabLabel" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/xz_text_hint</item>
    </style>

    <!-- .ctrl-btn { font-size: 11px; letter-spacing: 1px } -->
    <style name="Xz.Text.CtrlLabel" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/xz_text_secondary</item>
        <item name="android:letterSpacing">0.09</item>
    </style>

    <!-- ============ 控件 ============ -->

    <!-- .btn-primary { grad-user; radius-md; 14px padding; 15px/600 } -->
    <style name="Xz.Button.Primary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/xz_text_on_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.07</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- .btn-ghost { 透明底 + subtle 描边; 13px padding; 15px } -->
    <style name="Xz.Button.Ghost" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/xz_text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">13dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- .btn-danger -->
    <style name="Xz.Button.Danger" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/xz_error</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">13dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!--
      .field-input { height 44px; bg-input; radius-sm; 13px font-mono }
      :focus 的 box-shadow 聚焦环无原生等价物，改用 bg_field 的 state_focused 主色描边。
    -->
    <style name="Xz.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/xz_field_height</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/xz_text_primary</item>
        <item name="android:textColorHint">@color/xz_text_hint</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">13dp</item>
        <item name="android:paddingEnd">13dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- .add-bot-form .field-input { font-family: var(font-stack) } -->
    <style name="Xz.Field.Sans" parent="Xz.Field">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- .group-card -->
    <style name="Xz.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/xz_card_padding_h</item>
        <item name="android:paddingEnd">@dimen/xz_card_padding_h</item>
        <item name="android:paddingTop">@dimen/xz_card_padding_v</item>
        <item name="android:paddingBottom">@dimen/xz_card_padding_v</item>
    </style>
</resources>
