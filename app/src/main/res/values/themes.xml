<?xml version="1.0" encoding="utf-8"?>
<!--
  设计稿是纯深色，故父级选 Theme.MaterialComponents.NoActionBar（本身即深色主题），
  而不是 DayNight 变体：DayNight 会在浅色模式设备上挑走无人样式化的 values/，
  这正是重构前 SettingsActivity 发白的原因。values-night/ 因此一并删除。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HelloXiaoZhi" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/xz_primary</item>
        <item name="colorPrimaryVariant">@color/xz_grad_user_start</item>
        <item name="colorOnPrimary">@color/xz_text_on_primary</item>
        <item name="colorSecondary">@color/xz_accent_ai</item>
        <item name="colorOnSecondary">@color/xz_text_on_primary</item>
        <item name="colorSurface">@color/xz_bg_card</item>
        <item name="colorOnSurface">@color/xz_text_primary</item>
        <item name="android:colorBackground">@color/xz_bg_deep</item>

        <item name="android:windowBackground">@color/xz_bg_deep</item>
        <item name="android:statusBarColor">@color/xz_bg_blur</item>
        <item name="android:navigationBarColor">@color/xz_bg_blur</item>

        <item name="android:textColorPrimary">@color/xz_text_primary</item>
        <item name="android:textColorSecondary">@color/xz_text_secondary</item>
        <item name="android:textColorHint">@color/xz_text_hint</item>

        <!--
          部分 OEM 会对 targetSdk < 29 的应用在系统深色模式下强制反色，
          该属性在 API 29 以下被无害忽略。
        -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <!-- 语音通话页：整页星河背景，状态栏/导航栏同深底 -->
    <style name="Theme.HelloXiaoZhi.VoiceCall" parent="Theme.HelloXiaoZhi">
        <item name="android:statusBarColor">@color/xz_bg_deep</item>
        <item name="android:navigationBarColor">@color/xz_bg_deep</item>
    </style>
</resources>
