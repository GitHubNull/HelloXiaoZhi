<?xml version="1.0" encoding="utf-8"?>
<!--
  列表行按压反馈（.chat-item:active / .bot-item:hover）。
  minSdk 21 起 ripple 可用，波纹色取 rgba(148,163,184,.10)。
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/xz_row_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/xz_text_primary" />
        </shape>
    </item>
</ripple>
